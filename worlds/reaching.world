<sdf version="1.6">
	<world name="default">
		<light name="sun" type="directional">
			<cast_shadows>1</cast_shadows>
			<pose frame="">0 0 10 0 -0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>
		<model name="ground_plane">
			<static>1</static>
			<link name="link">
				<collision name="collision">
					<geometry>
						<plane>
							<normal>0 0 1</normal>
							<size>100 100</size>
						</plane>
					</geometry>
					<surface>
						<contact>
							<collide_bitmask>65535</collide_bitmask>
							<ode/>
						</contact>
						<friction>
							<ode>
								<mu>100</mu>
								<mu2>50</mu2>
							</ode>
							<torsional>
								<ode/>
							</torsional>
						</friction>
						<bounce/>
					</surface>
					<max_contacts>10</max_contacts>
				</collision>
				<visual name="visual">
					<cast_shadows>0</cast_shadows>
					<geometry>
						<plane>
							<normal>0 0 1</normal>
							<size>100 100</size>
						</plane>
					</geometry>
					<material>
						<script>
							<uri>file://media/materials/scripts/gazebo.material</uri>
							<name>Gazebo/Grey</name>
						</script>
					</material>
				</visual>
				<self_collide>0</self_collide>
				<enable_wind>0</enable_wind>
				<kinematic>0</kinematic>
			</link>
		</model>
		<gravity>0 0 -9.8</gravity>
		<magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
		<atmosphere type="adiabatic"/>
		<physics name="default_physics" default="0" type="ode">
			<max_step_size>0.001</max_step_size>
			<real_time_factor>1</real_time_factor>
			<real_time_update_rate>1000</real_time_update_rate>
		</physics>
		<scene>
			<ambient>0.4 0.4 0.4 1</ambient>
			<background>0.7 0.7 0.7 1</background>
			<shadows>1</shadows>
		</scene>
		<audio>
			<device>default</device>
		</audio>
		<wind/>
		<spherical_coordinates>
			<surface_model>EARTH_WGS84</surface_model>
			<latitude_deg>0</latitude_deg>
			<longitude_deg>0</longitude_deg>
			<elevation>0</elevation>
			<heading_deg>0</heading_deg>
		</spherical_coordinates>
		<!-- Default GUI camera: top-down view of the whole arena (26 m above the
		     home, pitched 90 deg down). Yaw rotates the view on screen if needed. -->
		<gui>
			<camera name="user_camera">
				<pose>0 0 26 0 1.5708 0</pose>
			</camera>
		</gui>
		<!-- gazebo_ros_state: exposes /gazebo/set_entity_state, used by
		     reaching_task.py to move the target marker between trials. -->
		<plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
			<ros>
				<namespace>/gazebo</namespace>
			</ros>
			<update_rate>10.0</update_rate>
		</plugin>
		<!-- Home marker: white disc on the floor at the robot's start pose.
		     Visual only (no collision), so the base drives over it freely. -->
		<model name="reaching_home">
			<static>1</static>
			<pose>0 0 0.005 0 0 0</pose>
			<link name="link">
				<visual name="visual">
					<geometry>
						<cylinder>
							<radius>0.35</radius>
							<length>0.01</length>
						</cylinder>
					</geometry>
					<material>
						<ambient>0.9 0.9 0.9 1</ambient>
						<diffuse>0.9 0.9 0.9 1</diffuse>
					</material>
				</visual>
			</link>
		</model>
		<!-- Target marker: green disc, moved onto the current goal by
		     reaching_task.py (/gazebo/set_entity_state). Starts hidden below the
		     ground plane. Non-static kinematic link (gravity off, no collision):
		     it stays where it is put and gzclient always redraws it when moved. -->
		<model name="reaching_target">
			<static>0</static>
			<pose>0 0 -2 0 0 0</pose>
			<link name="link">
				<kinematic>1</kinematic>
				<gravity>0</gravity>
				<inertial>
					<mass>0.1</mass>
				</inertial>
				<visual name="visual">
					<geometry>
						<cylinder>
							<radius>0.35</radius>
							<length>0.05</length>
						</cylinder>
					</geometry>
					<material>
						<ambient>0.1 0.9 0.1 1</ambient>
						<diffuse>0.1 0.9 0.1 1</diffuse>
						<emissive>0.1 0.5 0.1 1</emissive>
					</material>
				</visual>
			</link>
		</model>
	</world>
</sdf>
